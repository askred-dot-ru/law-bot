\pard\plain \fi720\qj\hyphpar1\sb0\sa0 \f4\fs24 \cs65552\f4\fs24 1. {\field{\*\fldinst {HYPERLINK \\l "sub_49"}}{\fldrslt {\cs24\b0\cf18 Обязательные работы}}}, {\field{\*\fldinst {HYPERLINK \\l "sub_50"}}{\fldrslt {\cs24\b0\cf18 исправительные работы}}}, {\field{\*\fldinst {HYPERLINK \\l "sub_51"}}{\fldrslt {\cs24\b0\cf18 ограничение по военной службе}}}, {\field{\*\fldinst {HYPERLINK \\l "sub_531"}}{\fldrslt {\cs24\b0\cf18 принудительные работы}}}, {\field{\*\fldinst {HYPERLINK \\l "sub_54"}}{\fldrslt {\cs24\b0\cf18 арест}}}, {\field{\*\fldinst {HYPERLINK \\l "sub_55"}}{\fldrslt {\cs24\b0\cf18 содержание}}} в дисциплинарной воинской части, {\field{\*\fldinst {HYPERLINK \\l "sub_56"}}{\fldrslt {\cs24\b0\cf18 лишение свободы}}} на определенный срок, {\field{\*\fldinst {HYPERLINK \\l "sub_57"}}{\fldrslt {\cs24\b0\cf18 пожизненное лишение свободы}}}, {\field{\*\fldinst {HYPERLINK \\l "sub_59"}}{\fldrslt {\cs24\b0\cf18 смертная казнь}}} применяются только в качестве основных видов наказаний.\par\pard
