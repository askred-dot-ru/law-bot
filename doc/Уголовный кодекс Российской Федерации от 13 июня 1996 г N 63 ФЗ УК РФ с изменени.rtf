\pard\plain \s31\fi-892\li1612\qj\hyphpar1\sb0\sa0 \f4\fs24 {\*\bkmkstart sub_1044}{\cs26\b1\cf17 \b1\cf17 Статья 104.4.} Судебный штраф\par\pard
{\*\bkmkend sub_1044}\pard\plain \s25\fi0\li170\qj\hyphpar1\sb75\sa0 \f4\fs24\cf19 \fs16\cf1 \chshdng0\chcfpat0\chcbpat20 ГАРАНТ:\par\pard
