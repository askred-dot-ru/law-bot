\pard\plain \s31\fi-892\li1612\qj\hyphpar1\sb0\sa0 \f4\fs24 {\*\bkmkstart sub_57}{\cs26\b1\cf17 \b1\cf17 Статья 57.} Пожизненное лишение свободы\par\pard
