\pard\plain \s38\fi0\li170\qj\hyphpar1\sb75\sa0 \f4\fs24\i1\cf19  \chshdng0\chcfpat0\chcbpat20 {\field{\*\fldinst {HYPERLINK "http://ivo.garant.ru/document/redirect/5219988/12"}}{\fldrslt {\cs24\b0\cf18 См. текст статьи в предыдущей редакции}}}\par\pard
