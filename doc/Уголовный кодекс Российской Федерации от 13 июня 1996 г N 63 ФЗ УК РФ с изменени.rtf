\pard\plain \fi720\qj\hyphpar1\sb0\sa0 \f4\fs24 \cs65552\f4\fs24 4. {\field{\*\fldinst {HYPERLINK "http://ivo.garant.ru/document/redirect/413006207/6"}}{\fldrslt {\cs24\b0\cf18 Тяжкими преступлениями}}} признаются умышленные деяния, за совершение которых максимальное наказание, предусмотренное настоящим Кодексом, не превышает десяти лет лишения свободы, и неосторожные деяния, за совершение которых максимальное наказание, предусмотренное настоящим Кодексом, не превышает пятнадцати лет лишения свободы.\par\pard
\pard\plain \fi720\qj\hyphpar1\sb0\sa0 \f4\fs24 {\*\bkmkstart sub_1505}\cs65552\f4\fs24 5. {\field{\*\fldinst {HYPERLINK "http://ivo.garant.ru/document/redirect/413006207/7"}}{\fldrslt {\cs24\b0\cf18 Особо тяжкими преступлениями}}} признаются умышленные деяния, за совершение которых настоящим Кодексом предусмотрено наказание в виде лишения свободы на срок свыше десяти лет или более строгое наказание.\par\pard
